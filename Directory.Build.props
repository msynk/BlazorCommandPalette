<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Authors>msynk</Authors>
    <Copyright>Copyright (c) msynk</Copyright>
    <RepositoryUrl>https://github.com/msynk/BlazorCommandPalette</RepositoryUrl>
    <PackageProjectUrl>https://github.com/msynk/BlazorCommandPalette</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>
</Project>
