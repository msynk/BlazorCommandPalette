@page "/settings"
@inject DemoState State
@implements IDisposable

<PageTitle>Settings · BlazorCommandPalette</PageTitle>

<h1>Settings</h1>
<p class="lead">These values are driven by the palette's toggle commands. Change them here or there — both stay in sync.</p>

<div class="list-group" style="max-width: 520px">
    <label class="list-group-item d-flex justify-content-between align-items-center">
        Theme
        <select class="form-select form-select-sm w-auto" value="@State.Theme" @onchange="OnThemeChanged">
            <option value="auto">Auto</option>
            <option value="light">Light</option>
            <option value="dark">Dark</option>
        </select>
    </label>
    <label class="list-group-item d-flex justify-content-between align-items-center">
        Word wrap <input class="form-check-input" type="checkbox" checked="@State.WordWrap" @onchange="State.ToggleWordWrap" />
    </label>
    <label class="list-group-item d-flex justify-content-between align-items-center">
        Desktop notifications <input class="form-check-input" type="checkbox" checked="@State.Notifications" @onchange="State.ToggleNotifications" />
    </label>
    <label class="list-group-item d-flex justify-content-between align-items-center">
        Show minimap <input class="form-check-input" type="checkbox" checked="@State.ShowMinimap" @onchange="State.ToggleMinimap" />
    </label>
</div>

@code {
    protected override void OnInitialized() => State.Changed += Refresh;

    private void Refresh() => InvokeAsync(StateHasChanged);

    private Task OnThemeChanged(ChangeEventArgs e) => State.SetThemeAsync(e.Value?.ToString() ?? "auto");

    public void Dispose() => State.Changed -= Refresh;
}
