@namespace BlazorCommandPalette.Components
@implements IDisposable
@inject ICommandPaletteService Palette

@code {
    private IDisposable? _registration;
    private IEnumerable<Command>? _last;

    /// <summary>
    /// Commands registered while this component is rendered (page-scoped commands, like kbar's <c>useRegisterActions</c>).
    /// </summary>
    [Parameter, EditorRequired] public IEnumerable<Command>? Commands { get; set; }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_last, Commands))
        {
            return;
        }

        _registration?.Dispose();
        _last = Commands;
        _registration = Commands is null ? null : Palette.Register(Commands);
    }

    public void Dispose() => _registration?.Dispose();
}
