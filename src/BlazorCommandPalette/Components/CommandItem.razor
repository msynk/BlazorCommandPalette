@namespace BlazorCommandPalette.Components
@implements IDisposable

<CascadingValue Value="this" IsFixed="true">
    @ChildContent
</CascadingValue>

@code {
    private string? _registeredId;
    private string? _signature;

    [CascadingParameter] private CommandPalette? Palette { get; set; }

    [CascadingParameter] private CommandGroup? Group { get; set; }

    [CascadingParameter] private CommandItem? ParentItem { get; set; }

    /// <summary>Stable id. Defaults to a slug of <see cref="Title"/>.</summary>
    [Parameter] public string? Id { get; set; }

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter] public string? Subtitle { get; set; }

    [Parameter] public string? Description { get; set; }

    /// <summary>Comma or space separated keywords.</summary>
    [Parameter] public string? Keywords { get; set; }

    /// <summary>Shortcut, e.g. <c>Mod+Shift+D</c> or <c>G I</c>.</summary>
    [Parameter] public string? Shortcut { get; set; }

    [Parameter] public bool GlobalShortcut { get; set; } = true;

    [Parameter] public RenderFragment? Icon { get; set; }

    [Parameter] public string? IconCss { get; set; }

    /// <summary>Navigation target (used when <see cref="OnExecute"/> is not set).</summary>
    [Parameter] public string? Href { get; set; }

    [Parameter] public bool NewTab { get; set; }

    /// <summary>Invoked when the item is selected. The palette closes afterwards unless <see cref="KeepOpen"/> is set.</summary>
    [Parameter] public EventCallback<CommandContext> OnExecute { get; set; }

    /// <summary>Keep the palette open after <see cref="OnExecute"/>.</summary>
    [Parameter] public bool KeepOpen { get; set; }

    [Parameter] public int? Priority { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public string? DisabledReason { get; set; }

    [Parameter] public bool Destructive { get; set; }

    [Parameter] public string? ConfirmMessage { get; set; }

    [Parameter] public string? Badge { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public bool? Checked { get; set; }

    [Parameter] public CommandKind? Kind { get; set; }

    [Parameter] public string[]? Tags { get; set; }

    [Parameter] public bool AlwaysShow { get; set; }

    /// <summary>Placeholder for the nested page when this item has child items.</summary>
    [Parameter] public string? ChildrenPlaceholder { get; set; }

    /// <summary>Allow checking several children before applying with Ctrl+Enter (calls <see cref="OnExecute"/> with the selection).</summary>
    [Parameter] public bool MultiSelect { get; set; }

    /// <summary>Nested <see cref="CommandItem"/>s turn this item into a page.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>The effective command id (available after parameters are set).</summary>
    public string CommandId => _registeredId ?? Id ?? CommandIdGenerator.FromTitle(Title, Group?.Heading, ParentItem?.CommandId);

    protected override void OnParametersSet()
    {
        if (Palette is null)
        {
            throw new InvalidOperationException($"{nameof(CommandItem)} must be placed inside a {nameof(CommandPalette)}.");
        }

        var signature = string.Join('\u001f', Id, Title, Subtitle, Description, Keywords, Shortcut, GlobalShortcut, IconCss, Href, NewTab,
            OnExecute.HasDelegate, KeepOpen, Priority, Disabled, DisabledReason, Destructive, ConfirmMessage, Badge, Value, Checked, Kind,
            Tags is null ? null : string.Join(',', Tags), AlwaysShow, ChildrenPlaceholder, MultiSelect, ChildContent is not null, Icon is not null,
            Group?.Heading, Group?.Priority, ParentItem?.CommandId);
        if (signature == _signature)
        {
            return;
        }

        _signature = signature;

        var b = new CommandBuilder(Title)
            .Subtitle(Subtitle)
            .Description(Description)
            .Group(Group?.Heading)
            .Parent(ParentItem?.CommandId)
            .Priority(Priority ?? Group?.Priority ?? CommandPriority.Normal)
            .Disabled(Disabled, DisabledReason)
            .Badge(Badge)
            .AlwaysShow(AlwaysShow)
            .ChildrenPlaceholder(ChildrenPlaceholder)
            .MultiSelect(MultiSelect);

        if (Id is not null) b.Id(Id);
        if (Value is not null) b.Value(Value);
        if (!string.IsNullOrWhiteSpace(Keywords)) b.Keywords(Keywords.Split([',', ' '], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        if (Shortcut is not null) b.Shortcut(Shortcut, GlobalShortcut);
        if (Icon is not null) b.Icon(Icon);
        if (IconCss is not null) b.Icon(IconCss);
        if (Checked is not null) b.Checked(Checked);
        if (Destructive) b.Destructive(ConfirmMessage); else if (ConfirmMessage is not null) b.Confirm(ConfirmMessage);
        var tags = (Tags ?? []).Concat(Group?.Tags ?? []).ToArray();
        if (tags.Length > 0) b.Tags(tags);

        if (OnExecute.HasDelegate)
        {
            var keepOpen = KeepOpen;
            var callback = OnExecute;
            b.Handler(async ctx =>
            {
                await callback.InvokeAsync(ctx);
                return keepOpen ? CommandResult.KeepOpen : CommandResult.Close;
            });
        }
        else if (Href is not null)
        {
            b.Href(Href, newTab: NewTab);
        }

        if (Kind is { } kind) b.Kind(kind);
        else if (ChildContent is not null) b.Kind(CommandKind.Page);

        var command = b.Build();
        if (_registeredId is not null && _registeredId != command.Id)
        {
            Palette.RemoveDeclarative(_registeredId);
        }

        _registeredId = command.Id;
        Palette.AddDeclarative(command);
    }

    public void Dispose()
    {
        if (_registeredId is not null)
        {
            Palette?.RemoveDeclarative(_registeredId);
        }
    }
}
